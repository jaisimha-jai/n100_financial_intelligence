<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="nifty100.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="3"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="2080"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="analysis" custom_title="0" dock_id="1" table="4,8:mainanalysis"/><dock_state state="000000ff00000000fd00000001000000020000000000000000fc0100000001fb000000160064006f0063006b00420072006f00770073006500310100000000ffffffff0000011300ffffff000000000000000000000004000000040000000800000008fc00000000"/><default_encoding codec=""/><browse_table_settings/></tab_browse><tab_sql><sql name="SQL 1*">SELECT DISTINCT sector FROM companies;
-- INFRA
UPDATE companies SET sector = 'Infra'
WHERE company_name LIKE '%Larsen%' OR company_name LIKE '%Adani Enterprises%';

-- METAL
UPDATE companies SET sector = 'Metal'
WHERE company_name LIKE '%Steel%' OR company_name LIKE '%Hindalco%';

-- POWER
UPDATE companies SET sector = 'Power'
WHERE company_name LIKE '%Power%' OR company_name LIKE '%NTPC%' OR company_name LIKE '%NHPC%';

-- TELECOM
UPDATE companies SET sector = 'Telecom'
WHERE company_name LIKE '%Airtel%';

-- OIL &amp; GAS
UPDATE companies SET sector = 'Oil &amp; Gas'
WHERE company_name LIKE '%Oil%' OR company_name LIKE '%Gas%' OR company_name LIKE '%ONGC%';

-- REAL ESTATE
UPDATE companies SET sector = 'Real Estate'
WHERE company_name LIKE '%DLF%' OR company_name LIKE '%Macrotech%';

-- CONSUMER DURABLES
UPDATE companies SET sector = 'Consumer Durables'
WHERE company_name LIKE '%Titan%' OR company_name LIKE '%Havells%';
SELECT sector, COUNT(*) FROM companies GROUP BY sector;</sql><current_tab id="0"/></tab_sql></sqlb_project>
